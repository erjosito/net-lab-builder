# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.first-run
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
# Copilot CLI: local state (skills, MCP config, session) — never commit
.copilot/
# Terraform: exclude state, plans, vars (may contain credentials or live resource IDs)
.terraform/
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!example.tfvars
.terraformrc
terraform.rc

# Lab session state (correlation_id reuse marker)
.lab-state.json

# Terraform plan binaries and raw run logs (lab artifacts; may embed live resource IDs)
tfplan
tfplan*
deploy-run-*.log
deploy*.log
plan-*-raw.txt
plan-*.txt

# Lab deploy artifacts that may contain PII, ER service keys, live resource IDs, or token traces
**/deploy/.akv-state.json
**/deploy/tf-outputs.json
**/deploy/tf-debug.log
**/deploy/.runtime.parameters.json
**/deploy/.lab-state.json
**/deploy/.blob-*.bin
*-debug.log
tf-outputs.json
