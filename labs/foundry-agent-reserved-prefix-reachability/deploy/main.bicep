// foundry-agent-reserved-prefix-reachability — main.bicep
// Tank IaC · 2026-08-14
//
// Implements:
//   vnet-foundry (swedencentral, 192.168.0.0/16) with AgentSubnet/PESubnet/MgmtSubnet/
//     DNSInboundSubnet/DNSOutboundSubnet/GatewaySubnet
//   vnet-onprem  (norwayeast, 172.30.0.0/16 + 10.200.100.0/24) with WorkloadSubnet/CtrlSubnet/GatewaySubnet
//   vpngw-foundry + vpngw-onprem — VpnGw1AZ, non-active-active, BGP ASNs 65010/65020
//   2 VNet-to-VNet connection objects (bidirectional, same PSK, BGP enabled)
//   3 VMs: vm-onprem-echo (172.30.100.4), vm-onprem-ctrl (10.200.100.4), vm-diag (192.168.2.4)
//   3 Foundry BYO dependencies (Storage/Search/Cosmos) + private endpoints + DNS zones
//   3 pre-created Foundry private DNS zones (no PE — Foundry account created manually)
//   NSGs for WorkloadSubnet, CtrlSubnet, MgmtSubnet
//   Optional DNS Private Resolver (deployDnsResolver=true, default false)
//
// NOT created by this template:
//   Azure AI Foundry account/project/endpoint
//   Azure OpenAI model deployment
//   ACR (not needed for prompt agents)
//
// VNet-to-VNet bidirectional shape explained:
//   ARM requires two distinct connection objects for a V2V pair.
//   conn-foundry-to-onprem: GW1=vpngw-foundry, GW2=vpngw-onprem (swedencentral)
//   conn-onprem-to-foundry: GW1=vpngw-onprem,  GW2=vpngw-foundry (norwayeast)
//   Both share the same PSK. Both have BGP enabled.
//   Microsoft portal docs: "To configure a VNet-to-VNet connection, you create a connection
//   from each virtual network gateway to the other virtual network gateway."
//
// VPN GW route-plane note (Trinity correction C4, 2026-08-14):
//   Azure VPN Gateway auto-advertises its connected VNet's declared address spaces, NOT individual
//   subnet prefixes. vpngw-onprem will advertise 172.30.0.0/16 and 10.200.100.0/24 to vpngw-foundry.
//   The reserved prefix arriving in vnet-foundry effective routes is therefore the full /16
//   (172.30.0.0/16), not only 172.30.100.0/24. This is the intended experiment condition.
//
// CtrlSubnet address space correction (vs manifest v1):
//   Manifest listed vnet-onprem second address space as 10.200.0.0/24 but CtrlSubnet as
//   10.200.100.0/24 — mutually exclusive. Corrected to 10.200.100.0/24 for both, matching vm IP.

targetScope = 'resourceGroup'

// ── Parameters ────────────────────────────────────────────────────────────────

@description('Correlation ID for tagging — auto-generated by deploy.ps1 if empty')
param correlationId string

@description('VM admin username')
param adminUsername string = 'labadmin'

@description('SSH public key value for all VMs (not path)')
param vmSshPublicKey string

@description('VM SKU — preflight confirmed Standard_B2ts_v2 in swedencentral + norwayeast 2026-08-14')
param vmSize string = 'Standard_B2ts_v2'

@description('Pre-shared key for both VNet-to-VNet connection objects (generated at deploy time; never persisted to disk)')
@secure()
param vpnPsk string

@description('Deploy optional Azure DNS Private Resolver (S5 scope). Default false.')
param deployDnsResolver bool = false

// ── Locations ─────────────────────────────────────────────────────────────────

var locFoundry = 'swedencentral'
var locOnprem  = 'norwayeast'

// ── Tags ──────────────────────────────────────────────────────────────────────

var tags = {
  lab: 'true'
  created_by: 'copilot-lab'
  lab_name: 'foundry-agent-reserved-prefix-reachability'
  ephemeral: 'true'
  correlation_id: correlationId
}

// ── Unique suffixes (Storage/Search/Cosmos names must be globally unique) ──────

var uniqueSuffix       = uniqueString(resourceGroup().id)
var storageAccountName = 'stlab${take(uniqueSuffix, 13)}'    // 5+13=18 ≤ 24
var searchServiceName  = 'srch-lab-${take(uniqueSuffix, 8)}' // 14 chars
var cosmosAccountName  = 'cosmos-lab-${take(uniqueSuffix, 8)}' // 19 chars

// ══════════════════════════════════════════════════════════════════════════════
// Wave 0 — Standard PIPs
// VpnGw1AZ requires zone-redundant (zones: ['1','2','3']) Standard Static PIPs.
// Non-active-active = one PIP per gateway.
// ══════════════════════════════════════════════════════════════════════════════

resource pipVpngwFoundry 'Microsoft.Network/publicIPAddresses@2023-09-01' = {
  name: 'pip-vpngw-foundry'
  location: locFoundry
  tags: tags
  sku: { name: 'Standard' }
  zones: ['1', '2', '3']
  properties: { publicIPAllocationMethod: 'Static' }
}

resource pipVpngwOnprem 'Microsoft.Network/publicIPAddresses@2023-09-01' = {
  name: 'pip-vpngw-onprem'
  location: locOnprem
  tags: tags
  sku: { name: 'Standard' }
  zones: ['1', '2', '3']
  properties: { publicIPAllocationMethod: 'Static' }
}

// ══════════════════════════════════════════════════════════════════════════════
// Wave 1 — NSGs
// AgentSubnet: no NSG initially — minimize confounders for route experiment
// GatewaySubnets: no NSG — Azure platform requirement
// PESubnet: no NSG
// ══════════════════════════════════════════════════════════════════════════════

// nsg-echo-vms: applied to WorkloadSubnet and CtrlSubnet (both target VMs)
// Rules: HTTP(80)/HTTPS(443) from Foundry VNet space, SSH from MgmtSubnet,
//        DNS(53) from DNSOutboundSubnet (active whether or not resolver deployed —
//        subnet exists either way), ICMP from Foundry VNet space
resource nsgEchoVms 'Microsoft.Network/networkSecurityGroups@2023-09-01' = {
  name: 'nsg-echo-vms'
  location: locOnprem
  tags: tags
  properties: {
    securityRules: [
      {
        name: 'allow-http-https-from-foundry'
        properties: {
          priority: 100
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: '192.168.0.0/16'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRanges: ['80', '443']
        }
      }
      {
        name: 'allow-ssh-from-mgmt'
        properties: {
          priority: 110
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: '192.168.2.0/27'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '22'
        }
      }
      {
        name: 'allow-dns-from-resolver-outbound'
        properties: {
          priority: 120
          direction: 'Inbound'
          access: 'Allow'
          protocol: '*'
          sourceAddressPrefix: '192.168.3.16/28'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '53'
        }
      }
      {
        name: 'allow-icmp-from-foundry'
        properties: {
          priority: 130
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Icmp'
          sourceAddressPrefix: '192.168.0.0/16'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '*'
        }
      }
    ]
  }
}

// nsg-mgmt: applied to MgmtSubnet (vm-diag)
// No public inbound; SSH allowed only from MgmtSubnet itself (for Run Command + internal jump)
resource nsgMgmt 'Microsoft.Network/networkSecurityGroups@2023-09-01' = {
  name: 'nsg-mgmt'
  location: locFoundry
  tags: tags
  properties: {
    securityRules: [
      {
        name: 'allow-ssh-intra-mgmt'
        properties: {
          priority: 100
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: '192.168.2.0/27'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '22'
        }
      }
    ]
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// Wave 2 — Virtual Networks
// ══════════════════════════════════════════════════════════════════════════════

// vnet-foundry: 192.168.0.0/16 — Class C RFC 1918, no reserved sub-ranges
// AgentSubnet /24 delegated to Microsoft.App/environments — the Foundry injection subnet
// PESubnet /24 — private endpoints (network policies disabled per PE requirement)
// MgmtSubnet /27 — vm-diag diagnostic VM
// DNSInboundSubnet /28 — DNS resolver inbound (exists even when resolver not deployed)
// DNSOutboundSubnet /28 — DNS resolver outbound (exists even when resolver not deployed)
// GatewaySubnet /27 — vpngw-foundry; NO NSG, NO UDR
resource vnetFoundry 'Microsoft.Network/virtualNetworks@2023-09-01' = {
  name: 'vnet-foundry'
  location: locFoundry
  tags: tags
  properties: {
    addressSpace: { addressPrefixes: ['192.168.0.0/16'] }
    subnets: [
      {
        name: 'AgentSubnet'
        properties: {
          addressPrefix: '192.168.0.0/24'
          // No NSG on AgentSubnet: minimize confounders; default gateway propagation is the variable under test
          delegations: [
            {
              name: 'delegation-appenv'
              properties: { serviceName: 'Microsoft.App/environments' }
            }
          ]
        }
      }
      {
        name: 'PESubnet'
        properties: {
          addressPrefix: '192.168.1.0/24'
          privateEndpointNetworkPolicies: 'Disabled'
        }
      }
      {
        name: 'MgmtSubnet'
        properties: {
          addressPrefix: '192.168.2.0/27'
          networkSecurityGroup: { id: nsgMgmt.id }
        }
      }
      {
        name: 'DNSInboundSubnet'
        properties: {
          addressPrefix: '192.168.3.0/28'
          delegations: [
            {
              name: 'delegation-dns-inbound'
              properties: { serviceName: 'Microsoft.Network/dnsResolvers' }
            }
          ]
        }
      }
      {
        name: 'DNSOutboundSubnet'
        properties: {
          addressPrefix: '192.168.3.16/28'
          delegations: [
            {
              name: 'delegation-dns-outbound'
              properties: { serviceName: 'Microsoft.Network/dnsResolvers' }
            }
          ]
        }
      }
      {
        name: 'GatewaySubnet'
        properties: {
          addressPrefix: '192.168.255.0/27'
          // Azure requirement: GatewaySubnet must have no NSG and no UDR
        }
      }
    ]
  }
}

// vnet-onprem: 172.30.0.0/16 + 10.200.100.0/24
// The /16 is the reserved prefix under test — it is the VNet's declared address space,
// not just a subnet prefix. vpngw-onprem will advertise the full 172.30.0.0/16 to vpngw-foundry.
// Note: CtrlSubnet 10.200.100.0/24 requires the second address space to be 10.200.100.0/24
//       (manifest v1 listed 10.200.0.0/24 — corrected here; see header comment)
resource vnetOnprem 'Microsoft.Network/virtualNetworks@2023-09-01' = {
  name: 'vnet-onprem'
  location: locOnprem
  tags: tags
  properties: {
    addressSpace: { addressPrefixes: ['172.30.0.0/16', '10.200.100.0/24'] }
    subnets: [
      {
        name: 'WorkloadSubnet'
        properties: {
          addressPrefix: '172.30.100.0/24'
          networkSecurityGroup: { id: nsgEchoVms.id }
        }
      }
      {
        name: 'CtrlSubnet'
        properties: {
          addressPrefix: '10.200.100.0/24'
          networkSecurityGroup: { id: nsgEchoVms.id }
        }
      }
      {
        name: 'GatewaySubnet'
        properties: {
          addressPrefix: '172.30.255.0/27'
          // No NSG, no UDR on GatewaySubnet
        }
      }
    ]
  }
}

// Subnet ID helpers (inline subnet reference pattern)
var agentSubnetId      = '${vnetFoundry.id}/subnets/AgentSubnet'
var peSubnetId         = '${vnetFoundry.id}/subnets/PESubnet'
var mgmtSubnetId       = '${vnetFoundry.id}/subnets/MgmtSubnet'
var gwSubnetFoundryId  = '${vnetFoundry.id}/subnets/GatewaySubnet'
var dnsInboundSubnetId = '${vnetFoundry.id}/subnets/DNSInboundSubnet'
var dnsOutboundSubnetId = '${vnetFoundry.id}/subnets/DNSOutboundSubnet'
var workloadSubnetId   = '${vnetOnprem.id}/subnets/WorkloadSubnet'
var ctrlSubnetId       = '${vnetOnprem.id}/subnets/CtrlSubnet'
var gwSubnetOnpremId   = '${vnetOnprem.id}/subnets/GatewaySubnet'

// ══════════════════════════════════════════════════════════════════════════════
// Wave 3 — VPN Gateways (long pole ~30-45 min; run in parallel with VMs)
// VpnGw1AZ, route-based, BGP enabled, NON-active-active (single ipConfig, single PIP)
// Non-AA chosen: HA is not the lab topic; AA adds second PIP and second BGP session (~2× GW cost)
// ══════════════════════════════════════════════════════════════════════════════

resource vpngwFoundry 'Microsoft.Network/virtualNetworkGateways@2023-09-01' = {
  name: 'vpngw-foundry'
  location: locFoundry
  tags: tags
  properties: {
    sku: { name: 'VpnGw1AZ', tier: 'VpnGw1AZ' }
    gatewayType: 'Vpn'
    vpnType: 'RouteBased'
    vpnGatewayGeneration: 'Generation1'
    enableBgp: true
    activeActive: false  // non-AA: single tunnel sufficient for reachability test
    bgpSettings: { asn: 65010 }
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          publicIPAddress: { id: pipVpngwFoundry.id }
          subnet: { id: gwSubnetFoundryId }
          privateIPAllocationMethod: 'Dynamic'
        }
      }
    ]
  }
}

resource vpngwOnprem 'Microsoft.Network/virtualNetworkGateways@2023-09-01' = {
  name: 'vpngw-onprem'
  location: locOnprem
  tags: tags
  properties: {
    sku: { name: 'VpnGw1AZ', tier: 'VpnGw1AZ' }
    gatewayType: 'Vpn'
    vpnType: 'RouteBased'
    vpnGatewayGeneration: 'Generation1'
    enableBgp: true
    activeActive: false
    bgpSettings: { asn: 65020 }
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          publicIPAddress: { id: pipVpngwOnprem.id }
          subnet: { id: gwSubnetOnpremId }
          privateIPAllocationMethod: 'Dynamic'
        }
      }
    ]
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// Wave 4 — VPN Connections (after both GWs provisioned)
// VNet-to-VNet requires two connection objects (one per direction).
// Both use the same PSK. BGP enabled on both.
// conn-foundry-to-onprem: location = swedencentral (GW1 region)
// conn-onprem-to-foundry: location = norwayeast    (GW1 region)
// ══════════════════════════════════════════════════════════════════════════════

resource connFoundryToOnprem 'Microsoft.Network/connections@2023-09-01' = {
  name: 'conn-foundry-to-onprem'
  location: locFoundry
  tags: tags
  properties: {
    connectionType: 'Vnet2Vnet'
    virtualNetworkGateway1: { id: vpngwFoundry.id, properties: {} }
    virtualNetworkGateway2: { id: vpngwOnprem.id, properties: {} }
    sharedKey: vpnPsk
    enableBgp: true
    routingWeight: 0
  }
}

resource connOnpremToFoundry 'Microsoft.Network/connections@2023-09-01' = {
  name: 'conn-onprem-to-foundry'
  location: locOnprem
  tags: tags
  properties: {
    connectionType: 'Vnet2Vnet'
    virtualNetworkGateway1: { id: vpngwOnprem.id, properties: {} }
    virtualNetworkGateway2: { id: vpngwFoundry.id, properties: {} }
    sharedKey: vpnPsk
    enableBgp: true
    routingWeight: 0
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// Wave 3 (parallel) — Network Interfaces + VMs
// All 3 VMs: Standard_B2ts_v2, Ubuntu 22.04 LTS Gen2, Standard SSD, no PIP
// cloud-init loaded from ./cloud-init/*.yaml at Bicep compile time
// ══════════════════════════════════════════════════════════════════════════════

// vm-onprem-echo: primary S4 test target; runs HTTP echo + HTTPS (self-signed) + dnsmasq
resource nicOnpremEcho 'Microsoft.Network/networkInterfaces@2023-09-01' = {
  name: 'nic-vm-onprem-echo'
  location: locOnprem
  tags: tags
  properties: {
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          subnet: { id: workloadSubnetId }
          privateIPAllocationMethod: 'Static'
          privateIPAddress: '172.30.100.4'
        }
      }
    ]
  }
}

resource vmOnpremEcho 'Microsoft.Compute/virtualMachines@2023-09-01' = {
  name: 'vm-onprem-echo'
  location: locOnprem
  tags: tags
  properties: {
    hardwareProfile: { vmSize: vmSize }
    storageProfile: {
      imageReference: {
        publisher: 'Canonical'
        offer: '0001-com-ubuntu-server-jammy'
        sku: '22_04-lts-gen2'
        version: 'latest'
      }
      osDisk: {
        name: 'osdisk-vm-onprem-echo'
        createOption: 'FromImage'
        managedDisk: { storageAccountType: 'StandardSSD_LRS' }
        deleteOption: 'Delete'
      }
    }
    osProfile: {
      computerName: 'vm-onprem-echo'
      adminUsername: adminUsername
      customData: loadFileAsBase64('cloud-init/echo-vm.yaml')
      linuxConfiguration: {
        disablePasswordAuthentication: true
        ssh: {
          publicKeys: [
            {
              path: '/home/${adminUsername}/.ssh/authorized_keys'
              keyData: vmSshPublicKey
            }
          ]
        }
      }
    }
    networkProfile: {
      networkInterfaces: [
        { id: nicOnpremEcho.id, properties: { primary: true, deleteOption: 'Delete' } }
      ]
    }
  }
}

// vm-onprem-ctrl: S3 control target (non-reserved prefix 10.200.100.0/24)
// Configuration-identical to vm-onprem-echo except LABEL="ctrl" and IP
// This isolates destination prefix as the sole independent variable between S3 and S4
resource nicOnpremCtrl 'Microsoft.Network/networkInterfaces@2023-09-01' = {
  name: 'nic-vm-onprem-ctrl'
  location: locOnprem
  tags: tags
  properties: {
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          subnet: { id: ctrlSubnetId }
          privateIPAllocationMethod: 'Static'
          privateIPAddress: '10.200.100.4'
        }
      }
    ]
  }
}

resource vmOnpremCtrl 'Microsoft.Compute/virtualMachines@2023-09-01' = {
  name: 'vm-onprem-ctrl'
  location: locOnprem
  tags: tags
  properties: {
    hardwareProfile: { vmSize: vmSize }
    storageProfile: {
      imageReference: {
        publisher: 'Canonical'
        offer: '0001-com-ubuntu-server-jammy'
        sku: '22_04-lts-gen2'
        version: 'latest'
      }
      osDisk: {
        name: 'osdisk-vm-onprem-ctrl'
        createOption: 'FromImage'
        managedDisk: { storageAccountType: 'StandardSSD_LRS' }
        deleteOption: 'Delete'
      }
    }
    osProfile: {
      computerName: 'vm-onprem-ctrl'
      adminUsername: adminUsername
      customData: loadFileAsBase64('cloud-init/ctrl-vm.yaml')
      linuxConfiguration: {
        disablePasswordAuthentication: true
        ssh: {
          publicKeys: [
            {
              path: '/home/${adminUsername}/.ssh/authorized_keys'
              keyData: vmSshPublicKey
            }
          ]
        }
      }
    }
    networkProfile: {
      networkInterfaces: [
        { id: nicOnpremCtrl.id, properties: { primary: true, deleteOption: 'Delete' } }
      ]
    }
  }
}

// vm-diag: diagnostic VM in vnet-foundry MgmtSubnet; no PIP; access via Azure Run Command
// Used for: effective-route capture, ping/curl verification, nslookup, tcpdump
resource nicDiag 'Microsoft.Network/networkInterfaces@2023-09-01' = {
  name: 'nic-vm-diag'
  location: locFoundry
  tags: tags
  properties: {
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          subnet: { id: mgmtSubnetId }
          privateIPAllocationMethod: 'Static'
          privateIPAddress: '192.168.2.4'
        }
      }
    ]
  }
}

resource vmDiag 'Microsoft.Compute/virtualMachines@2023-09-01' = {
  name: 'vm-diag'
  location: locFoundry
  tags: tags
  properties: {
    hardwareProfile: { vmSize: vmSize }
    storageProfile: {
      imageReference: {
        publisher: 'Canonical'
        offer: '0001-com-ubuntu-server-jammy'
        sku: '22_04-lts-gen2'
        version: 'latest'
      }
      osDisk: {
        name: 'osdisk-vm-diag'
        createOption: 'FromImage'
        managedDisk: { storageAccountType: 'StandardSSD_LRS' }
        deleteOption: 'Delete'
      }
    }
    osProfile: {
      computerName: 'vm-diag'
      adminUsername: adminUsername
      customData: loadFileAsBase64('cloud-init/diag-vm.yaml')
      linuxConfiguration: {
        disablePasswordAuthentication: true
        ssh: {
          publicKeys: [
            {
              path: '/home/${adminUsername}/.ssh/authorized_keys'
              keyData: vmSshPublicKey
            }
          ]
        }
      }
    }
    networkProfile: {
      networkInterfaces: [
        { id: nicDiag.id, properties: { primary: true, deleteOption: 'Delete' } }
      ]
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// Wave 3 (parallel) — Private DNS Zones (all global)
// BYO dependency zones: linked to vnet-foundry + PE DNS zone groups
// Pre-created Foundry zones: linked to vnet-foundry, no PE yet (Foundry not created by IaC)
// ══════════════════════════════════════════════════════════════════════════════

// BYO dependency zones
resource pdnsBlob 'Microsoft.Network/privateDnsZones@2020-06-01' = {
#disable-next-line no-hardcoded-env-urls // Zone name is a platform literal, not a URL reference
  name: 'privatelink.blob.core.windows.net'
  location: 'global'
  tags: tags
}
resource pdnsSearch 'Microsoft.Network/privateDnsZones@2020-06-01' = {
  name: 'privatelink.search.windows.net'
  location: 'global'
  tags: tags
}
resource pdnsCosmos 'Microsoft.Network/privateDnsZones@2020-06-01' = {
  name: 'privatelink.documents.azure.com'
  location: 'global'
  tags: tags
}

// Pre-created Foundry private DNS zones (no PE until Foundry account exists)
// Jose will add the Foundry private endpoint post-creation; these zones must pre-exist
// to allow Jose to integrate the DNS zone during the portal PE creation flow.
resource pdnsFoundryCogSvc 'Microsoft.Network/privateDnsZones@2020-06-01' = {
  name: 'privatelink.cognitiveservices.azure.com'
  location: 'global'
  tags: tags
}
resource pdnsFoundryOpenAi 'Microsoft.Network/privateDnsZones@2020-06-01' = {
  name: 'privatelink.openai.azure.com'
  location: 'global'
  tags: tags
}
resource pdnsFoundryAiSvc 'Microsoft.Network/privateDnsZones@2020-06-01' = {
  name: 'privatelink.services.ai.azure.com'
  location: 'global'
  tags: tags
}

// VNet links — all zones linked to vnet-foundry (enables PE resolution from VNet)
resource linkBlobToFoundry 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = {
  parent: pdnsBlob
  name: 'link-vnet-foundry'
  location: 'global'
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
    registrationEnabled: false
  }
}
resource linkSearchToFoundry 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = {
  parent: pdnsSearch
  name: 'link-vnet-foundry'
  location: 'global'
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
    registrationEnabled: false
  }
}
resource linkCosmosToFoundry 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = {
  parent: pdnsCosmos
  name: 'link-vnet-foundry'
  location: 'global'
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
    registrationEnabled: false
  }
}
resource linkCogSvcToFoundry 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = {
  parent: pdnsFoundryCogSvc
  name: 'link-vnet-foundry'
  location: 'global'
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
    registrationEnabled: false
  }
}
resource linkOpenAiToFoundry 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = {
  parent: pdnsFoundryOpenAi
  name: 'link-vnet-foundry'
  location: 'global'
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
    registrationEnabled: false
  }
}
resource linkAiSvcToFoundry 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2020-06-01' = {
  parent: pdnsFoundryAiSvc
  name: 'link-vnet-foundry'
  location: 'global'
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
    registrationEnabled: false
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// Wave 3 (parallel) — Foundry BYO Dependency Resources
// Public network access disabled; private endpoints in PESubnet
// Storage: Standard_LRS StorageV2 blob PE
// AI Search: Standard S1 searchService PE
// Cosmos DB: NoSQL serverless, Sql PE
// No ACR: this lab uses prompt agents (no container image, no hosted agent)
// ══════════════════════════════════════════════════════════════════════════════

resource storageAccount 'Microsoft.Storage/storageAccounts@2023-01-01' = {
  name: storageAccountName
  location: locFoundry
  tags: tags
  kind: 'StorageV2'
  sku: { name: 'Standard_LRS' }
  properties: {
    publicNetworkAccess: 'Disabled'
    allowBlobPublicAccess: false
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
    networkAcls: {
      defaultAction: 'Deny'
      bypass: 'AzureServices'
    }
  }
}

resource searchService 'Microsoft.Search/searchServices@2023-11-01' = {
  name: searchServiceName
  location: locFoundry
  tags: tags
  sku: { name: 'standard' }
  properties: {
    replicaCount: 1
    partitionCount: 1
    publicNetworkAccess: 'disabled'
  }
}

resource cosmosAccount 'Microsoft.DocumentDB/databaseAccounts@2023-11-15' = {
  name: cosmosAccountName
  location: locFoundry
  tags: tags
  kind: 'GlobalDocumentDB'
  properties: {
    databaseAccountOfferType: 'Standard'
    locations: [
      {
        locationName: locFoundry
        failoverPriority: 0
        isZoneRedundant: false
      }
    ]
    capabilities: [
      { name: 'EnableServerless' }
    ]
    publicNetworkAccess: 'Disabled'
    networkAclBypass: 'AzureServices'
    consistencyPolicy: {
      defaultConsistencyLevel: 'Session'
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// Wave 5 — Private Endpoints (after VNets + dependency resources ready)
// Each PE gets a DNS zone group to auto-register the PE IP in the private DNS zone
// ══════════════════════════════════════════════════════════════════════════════

resource peStorageBlob 'Microsoft.Network/privateEndpoints@2023-09-01' = {
  name: 'pe-storage-blob'
  location: locFoundry
  tags: tags
  properties: {
    subnet: { id: peSubnetId }
    privateLinkServiceConnections: [
      {
        name: 'plsc-storage-blob'
        properties: {
          privateLinkServiceId: storageAccount.id
          groupIds: ['blob']
        }
      }
    ]
  }
}

resource peStorageBlobDnsGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2023-09-01' = {
  parent: peStorageBlob
  name: 'dns-group'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'config-blob'
        properties: { privateDnsZoneId: pdnsBlob.id }
      }
    ]
  }
}

resource peSearch 'Microsoft.Network/privateEndpoints@2023-09-01' = {
  name: 'pe-search'
  location: locFoundry
  tags: tags
  properties: {
    subnet: { id: peSubnetId }
    privateLinkServiceConnections: [
      {
        name: 'plsc-search'
        properties: {
          privateLinkServiceId: searchService.id
          groupIds: ['searchService']
        }
      }
    ]
  }
}

resource peSearchDnsGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2023-09-01' = {
  parent: peSearch
  name: 'dns-group'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'config-search'
        properties: { privateDnsZoneId: pdnsSearch.id }
      }
    ]
  }
}

resource peCosmos 'Microsoft.Network/privateEndpoints@2023-09-01' = {
  name: 'pe-cosmos'
  location: locFoundry
  tags: tags
  properties: {
    subnet: { id: peSubnetId }
    privateLinkServiceConnections: [
      {
        name: 'plsc-cosmos'
        properties: {
          privateLinkServiceId: cosmosAccount.id
          groupIds: ['Sql']
        }
      }
    ]
  }
}

resource peCosmosDnsGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2023-09-01' = {
  parent: peCosmos
  name: 'dns-group'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'config-cosmos'
        properties: { privateDnsZoneId: pdnsCosmos.id }
      }
    ]
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// Optional — DNS Private Resolver (deployDnsResolver = true)
//
// Inbound endpoint role: provides a stable VNet IP (in DNSInboundSubnet) that
// external DNS servers (e.g., on-premises) can forward queries to. For this lab
// it is primarily a diagnostic handle: Jose can run
//   nslookup echo.onprem.lab <inbound-ep-ip>
// from vm-diag to test resolution in isolation without relying on VNet DNS config.
//
// Outbound endpoint + ruleset: forwarding rule for onprem.lab → 172.30.100.4:53
// (dnsmasq on vm-onprem-echo). VNet link propagates the rule to all VMs in
// vnet-foundry transparently — no VNet DNS server override needed.
// ══════════════════════════════════════════════════════════════════════════════

resource dnsResolver 'Microsoft.Network/dnsResolvers@2022-07-01' = if (deployDnsResolver) {
  name: 'dns-resolver-foundry'
  location: locFoundry
  tags: tags
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
  }
}

resource dnsInboundEp 'Microsoft.Network/dnsResolvers/inboundEndpoints@2022-07-01' = if (deployDnsResolver) {
  parent: dnsResolver
  name: 'ep-inbound'
  location: locFoundry
  tags: tags
  properties: {
    ipConfigurations: [
      {
        subnet: { id: dnsInboundSubnetId }
        privateIpAllocationMethod: 'Dynamic'
      }
    ]
  }
}

resource dnsOutboundEp 'Microsoft.Network/dnsResolvers/outboundEndpoints@2022-07-01' = if (deployDnsResolver) {
  parent: dnsResolver
  name: 'ep-outbound'
  location: locFoundry
  tags: tags
  properties: {
    subnet: { id: dnsOutboundSubnetId }
  }
}

resource dnsFwdRuleset 'Microsoft.Network/dnsForwardingRulesets@2022-07-01' = if (deployDnsResolver) {
  name: 'ruleset-onprem-lab'
  location: locFoundry
  tags: tags
  properties: {
    dnsResolverOutboundEndpoints: [
      { id: dnsOutboundEp.id }
    ]
  }
}

resource dnsFwdRuleOnpremLab 'Microsoft.Network/dnsForwardingRulesets/forwardingRules@2022-07-01' = if (deployDnsResolver) {
  parent: dnsFwdRuleset
  name: 'rule-onprem-lab'
  properties: {
    domainName: 'onprem.lab.'
    forwardingRuleState: 'Enabled'
    targetDnsServers: [
      { ipAddress: '172.30.100.4', port: 53 }
    ]
  }
}

resource dnsFwdRulesetVnetLink 'Microsoft.Network/dnsForwardingRulesets/virtualNetworkLinks@2022-07-01' = if (deployDnsResolver) {
  parent: dnsFwdRuleset
  name: 'link-vnet-foundry'
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
  }
}

