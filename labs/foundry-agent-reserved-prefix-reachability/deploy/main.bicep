output vnetOnpremId string = vnetOnprem.id

// Subnet IDs (Foundry portal needs these for VNet injection + PE creation)
output agentSubnetId string = agentSubnetId
output peSubnetId string = peSubnetId
output mgmtSubnetId string = mgmtSubnetId
output gwSubnetFoundryId string = gwSubnetFoundryId
output dnsInboundSubnetId string = dnsInboundSubnetId
output dnsOutboundSubnetId string = dnsOutboundSubnetId

// BYO dependency resource names (for Foundry portal "Storage tab > Select resources")
output storageAccountName string = storageAccountName
output storageAccountId string = storageAccount.id
output searchServiceName string = searchService.name
output searchServiceId string = searchService.id
output cosmosAccountName string = cosmosAccount.name
output cosmosAccountId string = cosmosAccount.id

// Private DNS zone IDs (for Foundry PE DNS integration)
output pdnsBlobId string = pdnsBlob.id
output pdnsSearchId string = pdnsSearch.id
output pdnsCosmosId string = pdnsCosmos.id
output pdnsFoundryCogSvcId string = pdnsFoundryCogSvc.id
output pdnsFoundryOpenAiId string = pdnsFoundryOpenAi.id
output pdnsFoundryAiSvcId string = pdnsFoundryAiSvc.id

// VPN Gateways
output vpngwFoundryId string = vpngwFoundry.id
output vpngwFoundryName string = vpngwFoundry.name
output vpngwOnpremId string = vpngwOnprem.id
output vpngwOnpremName string = vpngwOnprem.name
output pipVpngwFoundryIp string = pipVpngwFoundry.properties.ipAddress
output pipVpngwOnpremIp string = pipVpngwOnprem.properties.ipAddress

// VM IPs
output vmOnpremEchoIp string = nicOnpremEcho.properties.ipConfigurations[0].properties.privateIPAddress
output vmOnpremCtrlIp string = nicOnpremCtrl.properties.ipConfigurations[0].properties.privateIPAddress
output vmDiagIp string = nicDiag.properties.ipConfigurations[0].properties.privateIPAddress

// Optional DNS resolver outputs
#disable-next-line BCP318 // Conditional resource: property access is safe when deployDnsResolver=true
output dnsResolverInboundIp string = deployDnsResolver ? dnsInboundEp.properties.ipConfigurations[0].privateIpAddress : 'not-deployed'
output dnsResolverOutboundSubnetId string = deployDnsResolver ? dnsOutboundSubnetId : 'not-deployed'
