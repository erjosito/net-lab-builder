<mxfile host="app.diagrams.net">
  <diagram id="cleanup-dependency-order" name="Cleanup">
    <mxGraphModel dx="1600" dy="1000" grid="0" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" adaptiveColors="auto" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Cleanup dependency order — approval-gated and provider-safe" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="36" as="geometry"/></mxCell>
        <mxCell id="warning" value="Preview first; execute only after separate explicit cleanup approval. Do not delete the Azure resource group or isolated GCP project first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1560" height="48" as="geometry"/></mxCell>
        <mxCell id="s1" value="1 · Restore every experiment&#xa;Revert faults and capture final healthy evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="145" width="420" height="72" as="geometry"/></mxCell>
        <mxCell id="s2" value="2 · Disconnect Azure managed attachments&#xa;Remove both vWAN VPN site/link connections and the vHub ER connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="250" width="420" height="82" as="geometry"/></mxCell>
        <mxCell id="s3" value="3 · Release Azure ER private-peering linkage&#xa;Required before Megaport can release the circuit service relationship" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="365" width="420" height="82" as="geometry"/></mxCell>
        <mxCell id="s4" value="4 · Delete all three VXCs&#xa;Azure primary VXC · Azure secondary VXC · GCP Partner VXC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="480" width="420" height="82" as="geometry"/></mxCell>
        <mxCell id="s5" value="5 · Delete Megaport MCR&#xa;Only after every attached VXC is gone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="595" width="420" height="72" as="geometry"/></mxCell>
        <mxCell id="s6" value="6 · Delete Azure resource group&#xa;Provider links are released; cascading gateway deletion may take 30–60+ min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="700" width="420" height="82" as="geometry"/></mxCell>
        <mxCell id="s7" value="7 · Delete isolated GCP project&#xa;Verify billing detachment and no residual/shared resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="815" width="420" height="78" as="geometry"/></mxCell>
        <mxCell id="s8" value="8 · Remove local temporary secret material and protected deployment state&#xa;Only after provider cleanup evidence is complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="925" width="420" height="78" as="geometry"/></mxCell>
        <mxCell id="block1" value="Wrong order failure&#xa;Deleting RG first can leave gateway deletion running while Megaport VXC deletion returns 409." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="block2" value="Dependency rule&#xa;ER connection → ER peering linkage → VXCs → MCR → cloud containers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="410" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=3;" edge="1" source="s1" target="s2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078d4;strokeWidth=3;" edge="1" source="s2" target="s3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078d4;strokeWidth=3;" edge="1" source="s3" target="s4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=3;" edge="1" source="s4" target="s5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=3;" edge="1" source="s5" target="s6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078d4;strokeWidth=3;" edge="1" source="s6" target="s7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34a853;strokeWidth=3;" edge="1" source="s7" target="s8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
