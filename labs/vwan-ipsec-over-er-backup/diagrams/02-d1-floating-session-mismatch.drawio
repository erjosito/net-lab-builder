<mxfile host="app.diagrams.net">
  <diagram id="d1-floating-mismatch" name="D1">
    <mxGraphModel dx="1500" dy="800" grid="0" page="1" pageScale="1" pageWidth="1600" pageHeight="900" adaptiveColors="auto" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="D1 — one floating BGP identity: intended behavior versus managed-vWAN endpoint model" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="36" as="geometry"/></mxCell>
        <mxCell id="left" value="Intended CPE behavior" style="swimlane;startSize=34;html=1;fillColor=#f3fbf1;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="650" height="650" as="geometry"/></mxCell>
        <mxCell id="right" value="Managed vWAN endpoint reality to test" style="swimlane;startSize=34;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="730" y="85" width="730" height="650" as="geometry"/></mxCell>
        <mxCell id="cpe" value="CPE ASN 65050&#xa;shared peer 10.250.254.242/32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontStyle=1;fontSize=11;" vertex="1" parent="left"><mxGeometry x="215" y="70" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="floating" value="One logical BGP neighbor&#xa;keeps the same ASN + peer identity" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="left"><mxGeometry x="220" y="250" width="210" height="95" as="geometry"/></mxCell>
        <mxCell id="private-underlay" value="Private underlay&#xa;ER-carried IPsec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="left"><mxGeometry x="55" y="440" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="public-underlay" value="Alternate underlay&#xa;Internet IPsec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="left"><mxGeometry x="395" y="440" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="expected" value="Expected hypothesis: withdraw one transport, enable the other, and re-form the unchanged adjacency without changing route identity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="left"><mxGeometry x="95" y="545" width="460" height="62" as="geometry"/></mxCell>
        <mxCell id="site-private" value="VPN Site: site-gcp-er&#xa;private link&#xa;slots pri0 / pri1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;" vertex="1" parent="right"><mxGeometry x="45" y="85" width="270" height="92" as="geometry"/></mxCell>
        <mxCell id="site-public" value="VPN Site: site-gcp-inet&#xa;public link&#xa;slots pub0 / pub1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="right"><mxGeometry x="410" y="85" width="270" height="92" as="geometry"/></mxCell>
        <mxCell id="duplicate" value="D1 attempts the same site-scoped BGP identity&#xa;ASN 65050 / 10.250.254.242/32&#xa;on both independently modeled sites" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="right"><mxGeometry x="235" y="250" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="reject" value="Platform rejects duplicate peer identity&#xa;Capture sanitized API request/error&#xa;Do not bypass validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="right"><mxGeometry x="45" y="455" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="accept" value="Platform accepts model&#xa;Prove IKE/IPsec and endpoint reachability first;&#xa;then test neighbor movement both directions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="right"><mxGeometry x="400" y="455" width="285" height="90" as="geometry"/></mxCell>
        <mxCell id="verdict" value="D1 evidence is the exact failure stage: API model, tunnel binding, peer reachability, BGP re-establishment, or stale-route withdrawal. Implementation defects do not count." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="right"><mxGeometry x="100" y="565" width="530" height="58" as="geometry"/></mxCell>
        <mxCell id="e1" value="single identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=3;" edge="1" source="cpe" target="floating" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="primary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078d4;strokeWidth=3;" edge="1" source="floating" target="private-underlay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="same neighbor moves" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=3;dashed=1;" edge="1" source="floating" target="public-underlay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="same peer tuple" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" source="site-private" target="duplicate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="same peer tuple" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" source="site-public" target="duplicate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" source="duplicate" target="reject" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" source="duplicate" target="accept" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
