<mxfile host="app.diagrams.net">
  <diagram id="vwan-eripsec-topology" name="Topology">
    <mxGraphModel dx="1800" dy="1050" grid="0" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" adaptiveColors="auto" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="vWAN IPsec over ExpressRoute with Internet backup — physical and logical topology" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="36" as="geometry"/></mxCell>
        <mxCell id="pending" value="Pre-deploy logical view. Generated gateway IPs, tunnel peer IPs, MCR ASN, VLANs and provider IDs remain deployment-discovered." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1760" height="42" as="geometry"/></mxCell>
