        <mxCell id="partner" value="Partner Interconnect&#xa;VLAN attachment&#xa;pairing key: [deployment-discovered]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontSize=10;fontStyle=1;" vertex="1" parent="gcp-vpc"><mxGeometry x="205" y="270" width="150" height="82" as="geometry"/></mxCell>
        <mxCell id="public-ip" value="Reserved external IPv4&#xa;[deployment-discovered]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontSize=10;" vertex="1" parent="gcp-vpc"><mxGeometry x="35" y="275" width="145" height="70" as="geometry"/></mxCell>
        <mxCell id="prefixes" value="Experiment payloads — never simultaneous&#xa;D1 10.253.1.0/24 · D2 10.253.2.0/24&#xa;D3 10.253.3.0/24 + two /25s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="gcp-vpc"><mxGeometry x="55" y="365" width="270" height="68" as="geometry"/></mxCell>
        <mxCell id="anti-recursion" value="Anti-recursion: IKE /32 → physical NIC + intended underlay · Azure BGP peer /32 → assigned XFRM · fail-closed Null0 10.240.0.0/24 + 10.241.0.0/24 at AD 254" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="gcp-vpc"><mxGeometry x="35" y="445" width="310" height="54" as="geometry"/></mxCell>
