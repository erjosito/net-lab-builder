<mxfile host="app.diagrams.net">
  <diagram id="d2-four-adjacencies" name="D2">
    <mxGraphModel dx="1600" dy="900" grid="0" page="1" pageScale="1" pageWidth="1700" pageHeight="950" adaptiveColors="auto" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="D2 — four active-active IPsec/BGP adjacencies with private-path preference" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="36" as="geometry"/></mxCell>
        <mxCell id="note" value="Corrected bounded D2 retry: regular-private BGP on ER plus custom APIPA BGP on Internet. Four unique supported tuples; D2 remains the recommended healthy state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1560" height="42" as="geometry"/></mxCell>
        <mxCell id="cpe-zone" value="GCP Linux CPE · ASN 65050" style="swimlane;startSize=34;html=1;fillColor=#f0fbf3;strokeColor=#34a853;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="500" height="650" as="geometry"/></mxCell>
        <mxCell id="azure-zone" value="Azure vWAN VPN gateway · ASN 65515" style="swimlane;startSize=34;html=1;fillColor=#eef7ff;strokeColor=#0078d4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1060" y="135" width="540" height="650" as="geometry"/></mxCell>
        <mxCell id="ppeer" value="Private link BGP identity&#xa;10.250.254.240/32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontStyle=1;fontSize=11;" vertex="1" parent="cpe-zone"><mxGeometry x="140" y="70" width="220" height="68" as="geometry"/></mxCell>
