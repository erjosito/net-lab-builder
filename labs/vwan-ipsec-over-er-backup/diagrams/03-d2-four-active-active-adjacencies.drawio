        <mxCell id="pi0" value="pri0 · private Instance0&#xa;Azure default peer 10.240.0.12&#xa;source 10.250.254.240" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=10;" vertex="1" parent="azure-zone"><mxGeometry x="45" y="170" width="190" height="78" as="geometry"/></mxCell>
        <mxCell id="pi1" value="pri1 · private Instance1&#xa;Azure default peer 10.240.0.13&#xa;source 10.250.254.240" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=10;" vertex="1" parent="azure-zone"><mxGeometry x="305" y="170" width="190" height="78" as="geometry"/></mxCell>
