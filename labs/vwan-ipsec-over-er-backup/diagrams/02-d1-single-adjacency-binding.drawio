<mxfile host="app.diagrams.net">
  <diagram id="d1-single-adjacency-binding" name="D1">
    <mxGraphModel dx="1500" dy="800" grid="0" page="1" pageScale="1" pageWidth="1600" pageHeight="900" adaptiveColors="auto" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="D1 — one ordinary BGP adjacency moved between underlays" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="36" as="geometry"/></mxCell>
        <mxCell id="left" value="Approved bounded configuration" style="swimlane;startSize=34;html=1;fillColor=#f3fbf1;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="650" height="650" as="geometry"/></mxCell>
        <mxCell id="right" value="Managed data-plane binding question" style="swimlane;startSize=34;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="730" y="85" width="730" height="650" as="geometry"/></mxCell>
        <mxCell id="cpe" value="CPE ASN 65050&#xa;source 10.250.254.242/32&#xa;one FRR neighbor only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontStyle=1;fontSize=11;" vertex="1" parent="left"><mxGeometry x="215" y="70" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="floating" value="Unchanged tuple&#xa;10.250.254.242 → 10.240.0.12&#xa;Azure default neighbor · ASN 65515" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="left"><mxGeometry x="205" y="245" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="private-underlay" value="Phase A&#xa;.12/32 dev xfrm-pri1&#xa;private SA pri1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="left"><mxGeometry x="55" y="440" width="200" height="78" as="geometry"/></mxCell>
        <mxCell id="public-underlay" value="Phase B&#xa;move .12/32 to xfrm-pub1&#xa;public SA pub1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="left"><mxGeometry x="395" y="440" width="200" height="78" as="geometry"/></mxCell>
        <mxCell id="expected" value="No Azure object change between phases. Stop pri1, move only the peer /32 route, then reconnect the unchanged BGP tuple over pub1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="left"><mxGeometry x="95" y="555" width="460" height="66" as="geometry"/></mxCell>
        <mxCell id="site-private" value="site-gcp-er link&#xa;peer 10.250.254.242 · ASN 65050&#xa;vpnLinkConnection.enableBgp=true&#xa;two SAs: pri0 / pri1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;" vertex="1" parent="right"><mxGeometry x="45" y="75" width="285" height="112" as="geometry"/></mxCell>
        <mxCell id="site-public" value="site-gcp-inet link&#xa;distinct dormant peer 10.250.254.241&#xa;vpnLinkConnection.enableBgp=false&#xa;two SAs: pub0 / pub1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="right"><mxGeometry x="400" y="75" width="285" height="112" as="geometry"/></mxCell>
        <mxCell id="duplicate" value="Can Azure default neighbor 10.240.0.12 accept the unchanged .242 session over the healthy same-instance pub1 SA?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="right"><mxGeometry x="220" y="250" width="290" height="135" as="geometry"/></mxCell>
        <mxCell id="reject" value="Negative proof&#xa;pub1 SA and probes healthy; .242 → .12 SYN visible on pub1; no SYN-ACK/BGP establishment or return remains bound to pri1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="right"><mxGeometry x="35" y="455" width="310" height="105" as="geometry"/></mxCell>
        <mxCell id="accept" value="Pass&#xa;BGP Established on pub1, route continuity, and two repeatable private/public moves with the same tuple" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="right"><mxGeometry x="390" y="455" width="305" height="105" as="geometry"/></mxCell>
        <mxCell id="verdict" value="D1 is a data-plane binding experiment — not a supported floating Azure BGP object. Missing IKE, routes, selectors, or FRR initiation invalidates the run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="right"><mxGeometry x="90" y="585" width="550" height="58" as="geometry"/></mxCell>
        <mxCell id="e1" value="single identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=3;" edge="1" source="cpe" target="floating" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="initial /32 binding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078d4;strokeWidth=3;" edge="1" source="floating" target="private-underlay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="move only .12/32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=3;dashed=1;" edge="1" source="floating" target="public-underlay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="BGP-enabled link supplies tuple" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078d4;strokeWidth=2;" edge="1" source="site-private" target="duplicate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="healthy alternate SA; BGP disabled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;dashed=1;" edge="1" source="site-public" target="duplicate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="binding fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" source="duplicate" target="reject" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="binding moves" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;" edge="1" source="duplicate" target="accept" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
