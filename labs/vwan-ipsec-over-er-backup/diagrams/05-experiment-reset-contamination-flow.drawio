<mxfile host="app.diagrams.net">
  <diagram id="experiment-reset-flow" name="Reset flow">
    <mxGraphModel dx="1700" dy="900" grid="0" page="1" pageScale="1" pageWidth="1800" pageHeight="950" adaptiveColors="auto" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Experiment sequence and contamination gate" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell>
        <mxCell id="sequence" value="Evidence bundles: baseline → d1-floating → restore-1 → d2-separate → restore-2 → d3-prefix → compound → final-healthy (D2 baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1660" height="44" as="geometry"/></mxCell>
        <mxCell id="baseline" value="Capture healthy baseline&#xa;both MSEE paths + Partner Interconnect + probes healthy for 2 intervals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="230" height="88" as="geometry"/></mxCell>
        <mxCell id="apply" value="Apply versioned design bundle&#xa;D1, D2, or D3&#xa;advertise only its disjoint prefix set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="180" width="230" height="88" as="geometry"/></mxCell>
        <mxCell id="run" value="Run experiment + paired fault&#xa;capture before / during / after evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="180" width="230" height="88" as="geometry"/></mxCell>
        <mxCell id="restore" value="Run paired restore operation&#xa;load last-known-good bundle&#xa;revert every fault injection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="180" width="230" height="88" as="geometry"/></mxCell>
        <mxCell id="gate" value="Contamination gate passes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="170" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="next" value="Advance to next design&#xa;or restore/capture final D2 healthy state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1535" y="185" width="190" height="78" as="geometry"/></mxCell>
        <mxCell id="checks" value="Gate invariants" style="swimlane;startSize=34;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="365" y="360" width="850" height="390" as="geometry"/></mxCell>
        <mxCell id="check-prefix" value="Only the next design's prefix set exists in FRR, CPE RIB/FIB, vWAN effective routes, and probe NIC routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="checks"><mxGeometry x="35" y="65" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="check-state" value="No stale neighbor, route-map, prepend, static route, XFRM state/policy, child SA, nftables rule, or fault remains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="checks"><mxGeometry x="455" y="65" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="check-fault" value="All fault injections reverted; both ER MSEE paths and GCP Partner Interconnect operational" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="checks"><mxGeometry x="35" y="190" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="check-probe" value="Baseline probe succeeds for two consecutive sampling intervals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="checks"><mxGeometry x="455" y="190" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="stop" value="STOP — contaminated state&#xa;Do not continue experiments&#xa;Restore last-known-good bundle and compare saved inventories/config hashes&#xa;Failure to restore within 20 min ends the run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1285" y="455" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=3;" edge="1" source="baseline" target="apply" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078d4;strokeWidth=3;" edge="1" source="apply" target="run" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=3;" edge="1" source="run" target="restore" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=3;" edge="1" source="restore" target="gate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=3;" edge="1" source="gate" target="next" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" source="gate" target="stop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="repeat for next design" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;dashed=1;" edge="1" source="next" target="apply" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
