<mxfile host="app.diagrams.net">
  <diagram id="d3-prefix-blackhole" name="D3">
    <mxGraphModel dx="1600" dy="950" grid="0" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" adaptiveColors="auto" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="D3 — longest-prefix primary, static aggregate backup, and compound blackhole" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1450" height="36" as="geometry"/></mxCell>
        <mxCell id="normal" value="A · Normal: ER/BGP more-specifics win" style="swimlane;startSize=34;html=1;fillColor=#f3fbf1;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="500" height="670" as="geometry"/></mxCell>
        <mxCell id="failover" value="B · ER/BGP withdrawn: aggregate backup" style="swimlane;startSize=34;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="570" y="85" width="500" height="670" as="geometry"/></mxCell>
        <mxCell id="compound" value="C · Public IPsec down, then private BGP withdrawal" style="swimlane;startSize=34;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="85" width="500" height="670" as="geometry"/></mxCell>
        <mxCell id="n-probe" value="Azure workload probes&#xa;10.253.3.0/25 and 10.253.3.128/25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;" vertex="1" parent="normal"><mxGeometry x="95" y="65" width="310" height="72" as="geometry"/></mxCell>
        <mxCell id="n-rib" value="vWAN route choice&#xa;/25 beats covering /24" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="normal"><mxGeometry x="145" y="205" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="n-er" value="site-gcp-er · BGP enabled&#xa;10.253.3.0/25&#xa;10.253.3.128/25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;fontStyle=1;" vertex="1" parent="normal"><mxGeometry x="45" y="390" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="n-inet" value="site-gcp-inet · BGP disabled&#xa;static 10.253.3.0/24&#xa;CPE reverse static AD 250" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="normal"><mxGeometry x="270" y="390" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="f-probe" value="Same covered probes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;" vertex="1" parent="failover"><mxGeometry x="145" y="75" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="f-rib" value="Both /25 routes withdrawn&#xa;/24 becomes longest remaining match" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="failover"><mxGeometry x="125" y="205" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="f-er" value="ER/BGP path unavailable&#xa;/25s absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="failover"><mxGeometry x="45" y="390" width="190" height="88" as="geometry"/></mxCell>
        <mxCell id="f-inet" value="Internet/IPsec static /24&#xa;forwards covered traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="failover"><mxGeometry x="270" y="390" width="190" height="88" as="geometry"/></mxCell>
        <mxCell id="f-note" value="Deterministic failover, but the static route has no native BGP health signal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="failover"><mxGeometry x="85" y="535" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="c-probe" value="Covered probes after both failures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=11;" vertex="1" parent="compound"><mxGeometry x="120" y="75" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="c-rib" value="Stale static /24 still installed&#xa;and remains the longest available match" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="compound"><mxGeometry x="120" y="205" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="c-er" value="ER/BGP unavailable&#xa;/25s withdrawn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="compound"><mxGeometry x="45" y="390" width="190" height="88" as="geometry"/></mxCell>
        <mxCell id="c-inet" value="Internet/IPsec unavailable&#xa;but static /24 persists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="compound"><mxGeometry x="270" y="390" width="190" height="88" as="geometry"/></mxCell>
        <mxCell id="blackhole" value="BLACKHOLE&#xa;Route exists; forwarding path does not" style="ellipse;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8b0000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="compound"><mxGeometry x="145" y="535" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="reverse-order" value="Reverse path to Azure workload 10.241.0.0/24: private eBGP AD 20 → public-XFRM static AD 250 → fail-closed Null0 AD 254" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="785" width="1140" height="58" as="geometry"/></mxCell>
        <mxCell id="ne1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=3;" edge="1" source="n-probe" target="n-rib" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne2" value="selected /25s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078d4;strokeWidth=4;" edge="1" source="n-rib" target="n-er" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne3" value="less specific" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;dashed=1;" edge="1" source="n-rib" target="n-inet" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=3;" edge="1" source="f-probe" target="f-rib" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe2" value="unavailable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" source="f-rib" target="f-er" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe3" value="selected /24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=4;" edge="1" source="f-rib" target="f-inet" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" source="c-probe" target="c-rib" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce2" value="withdrawn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" source="c-rib" target="c-er" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce3" value="stale next hop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" source="c-rib" target="c-inet" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce4" value="drops traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8b0000;strokeWidth=4;" edge="1" source="c-inet" target="blackhole" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
