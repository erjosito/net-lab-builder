// foundry-agent-prompt-vs-hosted-networking -- main.bicep
// Tank IaC . 2026-08-20
//
// T1 Peered-Tools Topology: vnet-tools + bidirectional peering + 2 VMs + NSGs + DNS resolver.
//
// This template targets an EXISTING resource group that already contains the sibling-lab
// shared infrastructure (vnet-foundry, vm-diag, Foundry dependencies, etc.).
// It creates ONLY the lab-owned T1 resources listed below and never deletes existing ones.
//
// Resources created:
//   nsg-tools              -- Applied to EchoSubnet and CtrlSubnet
//   vnet-tools             -- 10.1.0.0/16, swedencentral
//     EchoSubnet           -- 10.1.100.0/24
//     CtrlSubnet           -- 10.1.200.0/24
//   VNet peering (2 objects):
//     vnet-foundry -> vnet-tools (on existing vnet-foundry)
//     vnet-tools   -> vnet-foundry
//   vm-tools-echo          -- 10.1.100.4, echo service + dnsmasq
//   vm-tools-ctrl          -- 10.1.200.4, echo service only
//   Optional (deployDnsResolver=true):
//     dns-resolver-foundry, ep-inbound, ep-outbound
//     ruleset-tools-lab (tools.lab -> 10.1.100.4:53)
//     link-vnet-foundry (VNet link propagates ruleset to all vnet-foundry subnets)
//   Optional NSG rules (patchAgentSubnetNsg=true):
//     Rules 110/120/125/126 on nsg-agentsubnet
//
// Prerequisites in the target RG:
//   vnet-foundry (192.168.0.0/16) with AgentSubnet, DNSInboundSubnet, DNSOutboundSubnet
//   nsg-agentsubnet (required when patchAgentSubnetNsg=true)
//
// Deployment mode: INCREMENTAL (safe; never deletes unmanaged resources).

targetScope = 'resourceGroup'

// ============================================================
// Parameters
// ============================================================

@description('Correlation ID for tagging -- auto-generated by deploy.ps1 if empty')
param correlationId string

@description('VM admin username')
param adminUsername string = 'labadmin'

@description('SSH public key value (not path)')
param vmSshPublicKey string

@description('VM SKU -- B2ts_v2 confirmed in swedencentral')
param vmSize string = 'Standard_B2ts_v2'

@description('Deploy DNS Private Resolver (Z2 recommended; set false if already deployed by sibling lab)')
param deployDnsResolver bool = true

@description('Add outbound NSG rules 110/120/125/126 to nsg-agentsubnet (Wave 4)')
param patchAgentSubnetNsg bool = true

@description('Name of the existing vnet-foundry resource in this RG')
param vnetFoundryName string = 'vnet-foundry'

@description('Name of the existing AgentSubnet NSG (used only when patchAgentSubnetNsg=true)')
param nsgAgentSubnetName string = 'vnet-foundry-AgentSubnet-nsg-swedencentral'

// ============================================================
// Variables
// ============================================================

var loc = 'swedencentral'

var tags = {
  lab: 'true'
  created_by: 'copilot-lab'
  lab_name: 'foundry-agent-prompt-vs-hosted-networking'
  ephemeral: 'true'
  correlation_id: correlationId
}

// ============================================================
// Existing resource references
// ============================================================

resource vnetFoundry 'Microsoft.Network/virtualNetworks@2023-09-01' existing = {
  name: vnetFoundryName
}

// nsg-agentsubnet: referenced for rule patching; must exist when patchAgentSubnetNsg=true.
resource nsgAgentSubnet 'Microsoft.Network/networkSecurityGroups@2023-09-01' existing = {
  name: nsgAgentSubnetName
}

// Subnet ID helpers for existing vnet-foundry subnets
var dnsInboundSubnetId  = '${vnetFoundry.id}/subnets/DNSInboundSubnet'
var dnsOutboundSubnetId = '${vnetFoundry.id}/subnets/DNSOutboundSubnet'

// ============================================================
// Wave 0 -- NSG for vnet-tools subnets
// ============================================================

resource nsgTools 'Microsoft.Network/networkSecurityGroups@2023-09-01' = {
  name: 'nsg-tools'
  location: loc
  tags: tags
  properties: {
    securityRules: [
      // Inbound: allow tool calls from Foundry VNet (data proxy + Micro VM NICs + vm-diag)
      {
        name: 'allow-in-http-https-from-foundry'
        properties: {
          priority: 100
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: '192.168.0.0/16'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRanges: ['80', '443']
        }
      }
      // Inbound: DNS outbound endpoint to dnsmasq on vm-tools-echo (Z2 path)
      // Rule is harmless on CtrlSubnet (no dnsmasq process there)
      {
        name: 'allow-in-dns-from-resolver-outbound'
        properties: {
          priority: 110
          direction: 'Inbound'
          access: 'Allow'
          protocol: '*'
          sourceAddressPrefix: '192.168.3.16/28'
          sourcePortRange: '*'
          destinationAddressPrefix: '10.1.100.0/24'
          destinationPortRange: '53'
        }
      }
      // Inbound: SSH from MgmtSubnet (vm-diag Run Command / jump)
      {
        name: 'allow-in-ssh-from-mgmt'
        properties: {
          priority: 200
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: '192.168.2.0/27'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '22'
        }
      }
      // Inbound default deny
      {
        name: 'deny-in-all'
        properties: {
          priority: 4000
          direction: 'Inbound'
          access: 'Deny'
          protocol: '*'
          sourceAddressPrefix: '*'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '*'
        }
      }
      // Outbound: allow all (echo VMs only receive; no controlled egress needed)
      {
        name: 'allow-out-all'
        properties: {
          priority: 100
          direction: 'Outbound'
          access: 'Allow'
          protocol: '*'
          sourceAddressPrefix: '*'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '*'
        }
      }
    ]
  }
}

// ============================================================
// Wave 0 -- vnet-tools (10.1.0.0/16)
// ============================================================

resource vnetTools 'Microsoft.Network/virtualNetworks@2023-09-01' = {
  name: 'vnet-tools'
  location: loc
  tags: tags
  properties: {
    addressSpace: { addressPrefixes: ['10.1.0.0/16'] }
    subnets: [
      {
        name: 'EchoSubnet'
        properties: {
          addressPrefix: '10.1.100.0/24'
          networkSecurityGroup: { id: nsgTools.id }
        }
      }
      {
        name: 'CtrlSubnet'
        properties: {
          addressPrefix: '10.1.200.0/24'
          networkSecurityGroup: { id: nsgTools.id }
        }
      }
    ]
  }
}

var echoSubnetId = '${vnetTools.id}/subnets/EchoSubnet'
var ctrlSubnetId = '${vnetTools.id}/subnets/CtrlSubnet'

// ============================================================
// Wave 1 -- Bidirectional VNet peering (no gateway transit)
// Both directions required; ARM creates them as separate objects.
// Flags: allowVirtualNetworkAccess=true (explicit -- CLI default is false on some versions).
//        allowForwardedTraffic=false, allowGatewayTransit=false, useRemoteGateways=false.
// ============================================================

resource peeringFoundryToTools 'Microsoft.Network/virtualNetworks/virtualNetworkPeerings@2023-09-01' = {
  parent: vnetFoundry
  name: 'peer-to-vnet-tools'
  properties: {
    allowVirtualNetworkAccess: true
    allowForwardedTraffic:     false
    allowGatewayTransit:       false
    useRemoteGateways:         false
    remoteVirtualNetwork: { id: vnetTools.id }
  }
}

resource peeringToolsToFoundry 'Microsoft.Network/virtualNetworks/virtualNetworkPeerings@2023-09-01' = {
  parent: vnetTools
  name: 'peer-to-vnet-foundry'
  properties: {
    allowVirtualNetworkAccess: true
    allowForwardedTraffic:     false
    allowGatewayTransit:       false
    useRemoteGateways:         false
    remoteVirtualNetwork: { id: vnetFoundry.id }
  }
}

// ============================================================
// Wave 2 -- Network Interfaces + VMs
// Ubuntu 22.04 LTS Gen2, Standard_B2ts_v2, no PIP, static IP .4 in each subnet
// cloud-init loaded at compile time via loadFileAsBase64
// ============================================================

resource nicToolsEcho 'Microsoft.Network/networkInterfaces@2023-09-01' = {
  name: 'nic-vm-tools-echo'
  location: loc
  tags: tags
  properties: {
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          subnet: { id: echoSubnetId }
          privateIPAllocationMethod: 'Static'
          privateIPAddress: '10.1.100.4'
        }
      }
    ]
  }
}

resource vmToolsEcho 'Microsoft.Compute/virtualMachines@2023-09-01' = {
  name: 'vm-tools-echo'
  location: loc
  tags: tags
  properties: {
    hardwareProfile: { vmSize: vmSize }
    storageProfile: {
      imageReference: {
        publisher: 'Canonical'
        offer: '0001-com-ubuntu-server-jammy'
        sku: '22_04-lts-gen2'
        version: 'latest'
      }
      osDisk: {
        name: 'osdisk-vm-tools-echo'
        createOption: 'FromImage'
        managedDisk: { storageAccountType: 'StandardSSD_LRS' }
        deleteOption: 'Delete'
      }
    }
    osProfile: {
      computerName: 'vm-tools-echo'
      adminUsername: adminUsername
      customData: loadFileAsBase64('cloud-init/echo-vm.yaml')
      linuxConfiguration: {
        disablePasswordAuthentication: true
        ssh: {
          publicKeys: [
            {
              path: '/home/${adminUsername}/.ssh/authorized_keys'
              keyData: vmSshPublicKey
            }
          ]
        }
      }
    }
    networkProfile: {
      networkInterfaces: [
        { id: nicToolsEcho.id, properties: { primary: true, deleteOption: 'Delete' } }
      ]
    }
  }
}

resource nicToolsCtrl 'Microsoft.Network/networkInterfaces@2023-09-01' = {
  name: 'nic-vm-tools-ctrl'
  location: loc
  tags: tags
  properties: {
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          subnet: { id: ctrlSubnetId }
          privateIPAllocationMethod: 'Static'
          privateIPAddress: '10.1.200.4'
        }
      }
    ]
  }
}

resource vmToolsCtrl 'Microsoft.Compute/virtualMachines@2023-09-01' = {
  name: 'vm-tools-ctrl'
  location: loc
  tags: tags
  properties: {
    hardwareProfile: { vmSize: vmSize }
    storageProfile: {
      imageReference: {
        publisher: 'Canonical'
        offer: '0001-com-ubuntu-server-jammy'
        sku: '22_04-lts-gen2'
        version: 'latest'
      }
      osDisk: {
        name: 'osdisk-vm-tools-ctrl'
        createOption: 'FromImage'
        managedDisk: { storageAccountType: 'StandardSSD_LRS' }
        deleteOption: 'Delete'
      }
    }
    osProfile: {
      computerName: 'vm-tools-ctrl'
      adminUsername: adminUsername
      customData: loadFileAsBase64('cloud-init/ctrl-vm.yaml')
      linuxConfiguration: {
        disablePasswordAuthentication: true
        ssh: {
          publicKeys: [
            {
              path: '/home/${adminUsername}/.ssh/authorized_keys'
              keyData: vmSshPublicKey
            }
          ]
        }
      }
    }
    networkProfile: {
      networkInterfaces: [
        { id: nicToolsCtrl.id, properties: { primary: true, deleteOption: 'Delete' } }
      ]
    }
  }
}

// ============================================================
// Wave 3 (optional) -- DNS Private Resolver (Z2 path)
// Deploys only when deployDnsResolver=true.
// If sibling lab already deployed dns-resolver-foundry with the same resource name,
// incremental mode will idempotently update it; the forwarding ruleset is new (different name).
// Set deployDnsResolver=false if the resolver already exists AND the outbound EP is in place.
// ============================================================

resource dnsResolver 'Microsoft.Network/dnsResolvers@2022-07-01' = if (deployDnsResolver) {
  name: 'dns-resolver-foundry'
  location: loc
  tags: tags
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
  }
}

resource dnsInboundEp 'Microsoft.Network/dnsResolvers/inboundEndpoints@2022-07-01' = if (deployDnsResolver) {
  parent: dnsResolver
  name: 'ep-inbound'
  location: loc
  tags: tags
  properties: {
    ipConfigurations: [
      {
        subnet: { id: dnsInboundSubnetId }
        privateIpAllocationMethod: 'Dynamic'
      }
    ]
  }
}

resource dnsOutboundEp 'Microsoft.Network/dnsResolvers/outboundEndpoints@2022-07-01' = if (deployDnsResolver) {
  parent: dnsResolver
  name: 'ep-outbound'
  location: loc
  tags: tags
  properties: {
    subnet: { id: dnsOutboundSubnetId }
  }
}

// Forwarding ruleset for tools.lab -> 10.1.100.4:53 (dnsmasq on vm-tools-echo)
resource dnsFwdRuleset 'Microsoft.Network/dnsForwardingRulesets@2022-07-01' = if (deployDnsResolver) {
  name: 'ruleset-tools-lab'
  location: loc
  tags: tags
  properties: {
    dnsResolverOutboundEndpoints: [
      { id: dnsOutboundEp.id }
    ]
  }
}

resource dnsFwdRuleToolsLab 'Microsoft.Network/dnsForwardingRulesets/forwardingRules@2022-07-01' = if (deployDnsResolver) {
  parent: dnsFwdRuleset
  name: 'rule-tools-lab'
  properties: {
    domainName: 'tools.lab.'
    forwardingRuleState: 'Enabled'
    targetDnsServers: [
      { ipAddress: '10.1.100.4', port: 53 }
    ]
  }
}

// VNet link propagates the tools.lab forwarding rule to ALL subnets in vnet-foundry
// (AgentSubnet, MgmtSubnet, PESubnet) without any per-subnet override.
resource dnsFwdRulesetVnetLink 'Microsoft.Network/dnsForwardingRulesets/virtualNetworkLinks@2022-07-01' = if (deployDnsResolver) {
  parent: dnsFwdRuleset
  name: 'link-vnet-foundry'
  properties: {
    virtualNetwork: { id: vnetFoundry.id }
  }
}

// ============================================================
// Wave 4 (optional) -- AgentSubnet NSG outbound rule patch
// Adds rules 110/120/125/126 to existing nsg-agentsubnet.
// patchAgentSubnetNsg=false if the rules already exist from a prior run.
// nsg-agentsubnet must exist in the RG when this flag is true.
// ============================================================

resource nsgRuleEchoOut 'Microsoft.Network/networkSecurityGroups/securityRules@2023-09-01' = if (patchAgentSubnetNsg) {
  parent: nsgAgentSubnet
  name: 'allow-out-echo-subnet'
  properties: {
    priority: 110
    direction: 'Outbound'
    access: 'Allow'
    protocol: 'Tcp'
    sourceAddressPrefix: '*'
    sourcePortRange: '*'
    destinationAddressPrefix: '10.1.100.0/24'
    destinationPortRanges: ['80', '443']
    description: 'Tool + code calls to vm-tools-echo (HS1, HS2, HS3)'
  }
}

resource nsgRuleCtrlOut 'Microsoft.Network/networkSecurityGroups/securityRules@2023-09-01' = if (patchAgentSubnetNsg) {
  parent: nsgAgentSubnet
  name: 'allow-out-ctrl-subnet'
  properties: {
    priority: 120
    direction: 'Outbound'
    access: 'Allow'
    protocol: 'Tcp'
    sourceAddressPrefix: '*'
    sourcePortRange: '*'
    destinationAddressPrefix: '10.1.200.0/24'
    destinationPortRanges: ['80', '443']
    description: 'Tool calls to vm-tools-ctrl (HS4)'
  }
}

// Rules 125+126: required for ALL source-code hosted-agent deployments (remote_build AND bundled).
// The base container image is pulled from MCR at Micro VM startup regardless of dep-resolution mode.
resource nsgRuleMcrOut 'Microsoft.Network/networkSecurityGroups/securityRules@2023-09-01' = if (patchAgentSubnetNsg) {
  parent: nsgAgentSubnet
  name: 'allow-out-mcr'
  properties: {
    priority: 125
    direction: 'Outbound'
    access: 'Allow'
    protocol: 'Tcp'
    sourceAddressPrefix: '*'
    sourcePortRange: '*'
    destinationAddressPrefix: 'MicrosoftContainerRegistry'
    destinationPortRange: '443'
    description: 'MCR base image pull -- required for ALL source-code deploy modes (C1 correction)'
  }
}

resource nsgRuleAadOut 'Microsoft.Network/networkSecurityGroups/securityRules@2023-09-01' = if (patchAgentSubnetNsg) {
  parent: nsgAgentSubnet
  name: 'allow-out-aad'
  properties: {
    priority: 126
    direction: 'Outbound'
    access: 'Allow'
    protocol: 'Tcp'
    sourceAddressPrefix: '*'
    sourcePortRange: '*'
    destinationAddressPrefix: 'AzureActiveDirectory'
    destinationPortRange: '443'
    description: '*.login.microsoft.com for Micro VM auth -- required for ALL source-code deploy modes'
  }
}

// ============================================================
// Outputs
// ============================================================

output vnetToolsId   string = vnetTools.id
output echoSubnetId  string = echoSubnetId
output ctrlSubnetId  string = ctrlSubnetId
output vmToolsEchoIp string = nicToolsEcho.properties.ipConfigurations[0].properties.privateIPAddress
output vmToolsCtrlIp string = nicToolsCtrl.properties.ipConfigurations[0].properties.privateIPAddress

#disable-next-line BCP318
output dnsResolverInboundIp  string = deployDnsResolver ? dnsInboundEp.properties.ipConfigurations[0].privateIpAddress : 'not-deployed'
output dnsResolverOutboundEpSubnetId string = deployDnsResolver ? dnsOutboundSubnetId : 'not-deployed'