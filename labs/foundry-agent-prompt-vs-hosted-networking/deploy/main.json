{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.40.2.10011",
      "templateHash": "17774526896546218662"
    }
  },
  "parameters": {
    "correlationId": {
      "type": "string",
      "metadata": {
        "description": "Correlation ID for tagging -- auto-generated by deploy.ps1 if empty"
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "labadmin",
      "metadata": {
        "description": "VM admin username"
      }
    },
    "vmSshPublicKey": {
      "type": "string",
      "metadata": {
        "description": "SSH public key value (not path)"
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_B2ts_v2",
      "metadata": {
        "description": "VM SKU -- B2ts_v2 confirmed in swedencentral"
      }
    },
    "deployDnsResolver": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy DNS Private Resolver (Z2 recommended; set false if already deployed by sibling lab)"
      }
    },
    "patchAgentSubnetNsg": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Add outbound NSG rules 110/120/125/126 to nsg-agentsubnet (Wave 4)"
      }
    },
    "vnetFoundryName": {
      "type": "string",
      "defaultValue": "vnet-foundry",
      "metadata": {
        "description": "Name of the existing vnet-foundry resource in this RG"
      }
    },
    "nsgAgentSubnetName": {
      "type": "string",
      "defaultValue": "vnet-foundry-AgentSubnet-nsg-swedencentral",
      "metadata": {
        "description": "Name of the existing AgentSubnet NSG (used only when patchAgentSubnetNsg=true)"
      }
    }
  },
  "variables": {
    "$fxv#0": "",
    "$fxv#1": "",
    "loc": "swedencentral",
    "tags": {
      "lab": "true",
      "created_by": "copilot-lab",
      "lab_name": "foundry-agent-prompt-vs-hosted-networking",
      "ephemeral": "true",
      "correlation_id": "[parameters('correlationId')]"
    },
    "dnsInboundSubnetId": "[format('{0}/subnets/DNSInboundSubnet', resourceId('Microsoft.Network/virtualNetworks', parameters('vnetFoundryName')))]",
    "dnsOutboundSubnetId": "[format('{0}/subnets/DNSOutboundSubnet', resourceId('Microsoft.Network/virtualNetworks', parameters('vnetFoundryName')))]",
    "echoSubnetId": "[format('{0}/subnets/EchoSubnet', resourceId('Microsoft.Network/virtualNetworks', 'vnet-tools'))]",
    "ctrlSubnetId": "[format('{0}/subnets/CtrlSubnet', resourceId('Microsoft.Network/virtualNetworks', 'vnet-tools'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "nsg-tools",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-in-http-https-from-foundry",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "192.168.0.0/16",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRanges": [
                "80",
                "443"
              ]
            }
          },
          {
            "name": "allow-in-dns-from-resolver-outbound",
            "properties": {
              "priority": 110,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "*",
              "sourceAddressPrefix": "192.168.3.16/28",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "10.1.100.0/24",
              "destinationPortRange": "53"
            }
          },
          {
            "name": "allow-in-ssh-from-mgmt",
            "properties": {
              "priority": 200,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "192.168.2.0/27",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "22"
            }
          },
          {
            "name": "deny-in-all",
            "properties": {
              "priority": 4000,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "*"
            }
          },
          {
            "name": "allow-out-all",
            "properties": {
              "priority": 100,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "*"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "vnet-tools",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.1.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "EchoSubnet",
            "properties": {
              "addressPrefix": "10.1.100.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-tools')]"
              }
            }
          },
          {
            "name": "CtrlSubnet",
            "properties": {
              "addressPrefix": "10.1.200.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-tools')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-tools')]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/{1}', parameters('vnetFoundryName'), 'peer-to-vnet-tools')]",
      "properties": {
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false,
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-tools')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-tools')]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/{1}', 'vnet-tools', 'peer-to-vnet-foundry')]",
      "properties": {
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false,
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetFoundryName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-tools')]"
      ]
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "nic-vm-tools-echo",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('echoSubnetId')]"
              },
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "10.1.100.4"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-tools')]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "vm-tools-echo",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },
          "osDisk": {
            "name": "osdisk-vm-tools-echo",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            },
            "deleteOption": "Delete"
          }
        },
        "osProfile": {
          "computerName": "vm-tools-echo",
          "adminUsername": "[parameters('adminUsername')]",
          "customData": "[variables('$fxv#0')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
                  "keyData": "[parameters('vmSshPublicKey')]"
                }
              ]
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'nic-vm-tools-echo')]",
              "properties": {
                "primary": true,
                "deleteOption": "Delete"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'nic-vm-tools-echo')]"
      ]
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "nic-vm-tools-ctrl",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('ctrlSubnetId')]"
              },
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "10.1.200.4"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-tools')]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "vm-tools-ctrl",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },
          "osDisk": {
            "name": "osdisk-vm-tools-ctrl",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            },
            "deleteOption": "Delete"
          }
        },
        "osProfile": {
          "computerName": "vm-tools-ctrl",
          "adminUsername": "[parameters('adminUsername')]",
          "customData": "[variables('$fxv#1')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
                  "keyData": "[parameters('vmSshPublicKey')]"
                }
              ]
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'nic-vm-tools-ctrl')]",
              "properties": {
                "primary": true,
                "deleteOption": "Delete"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'nic-vm-tools-ctrl')]"
      ]
    },
    {
      "condition": "[parameters('deployDnsResolver')]",
      "type": "Microsoft.Network/dnsResolvers",
      "apiVersion": "2022-07-01",
      "name": "dns-resolver-foundry",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetFoundryName'))]"
        }
      }
    },
    {
      "condition": "[parameters('deployDnsResolver')]",
      "type": "Microsoft.Network/dnsResolvers/inboundEndpoints",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', 'dns-resolver-foundry', 'ep-inbound')]",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "ipConfigurations": [
          {
            "subnet": {
              "id": "[variables('dnsInboundSubnetId')]"
            },
            "privateIpAllocationMethod": "Dynamic"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/dnsResolvers', 'dns-resolver-foundry')]"
      ]
    },
    {
      "condition": "[parameters('deployDnsResolver')]",
      "type": "Microsoft.Network/dnsResolvers/outboundEndpoints",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', 'dns-resolver-foundry', 'ep-outbound')]",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "subnet": {
          "id": "[variables('dnsOutboundSubnetId')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/dnsResolvers', 'dns-resolver-foundry')]"
      ]
    },
    {
      "condition": "[parameters('deployDnsResolver')]",
      "type": "Microsoft.Network/dnsForwardingRulesets",
      "apiVersion": "2022-07-01",
      "name": "ruleset-tools-lab",
      "location": "[variables('loc')]",
      "tags": "[variables('tags')]",
      "properties": {
        "dnsResolverOutboundEndpoints": [
          {
            "id": "[resourceId('Microsoft.Network/dnsResolvers/outboundEndpoints', 'dns-resolver-foundry', 'ep-outbound')]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/dnsResolvers/outboundEndpoints', 'dns-resolver-foundry', 'ep-outbound')]"
      ]
    },
    {
      "condition": "[parameters('deployDnsResolver')]",
      "type": "Microsoft.Network/dnsForwardingRulesets/forwardingRules",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', 'ruleset-tools-lab', 'rule-tools-lab')]",
      "properties": {
        "domainName": "tools.lab.",
        "forwardingRuleState": "Enabled",
        "targetDnsServers": [
          {
            "ipAddress": "10.1.100.4",
            "port": 53
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/dnsForwardingRulesets', 'ruleset-tools-lab')]"
      ]
    },
    {
      "condition": "[parameters('deployDnsResolver')]",
      "type": "Microsoft.Network/dnsForwardingRulesets/virtualNetworkLinks",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', 'ruleset-tools-lab', 'link-vnet-foundry')]",
      "properties": {
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetFoundryName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/dnsForwardingRulesets', 'ruleset-tools-lab')]"
      ]
    },
    {
      "condition": "[parameters('patchAgentSubnetNsg')]",
      "type": "Microsoft.Network/networkSecurityGroups/securityRules",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/{1}', parameters('nsgAgentSubnetName'), 'allow-out-echo-subnet')]",
      "properties": {
        "priority": 110,
        "direction": "Outbound",
        "access": "Allow",
        "protocol": "Tcp",
        "sourceAddressPrefix": "*",
        "sourcePortRange": "*",
        "destinationAddressPrefix": "10.1.100.0/24",
        "destinationPortRanges": [
          "80",
          "443"
        ],
        "description": "Tool + code calls to vm-tools-echo (HS1, HS2, HS3)"
      }
    },
    {
      "condition": "[parameters('patchAgentSubnetNsg')]",
      "type": "Microsoft.Network/networkSecurityGroups/securityRules",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/{1}', parameters('nsgAgentSubnetName'), 'allow-out-ctrl-subnet')]",
      "properties": {
        "priority": 120,
        "direction": "Outbound",
        "access": "Allow",
        "protocol": "Tcp",
        "sourceAddressPrefix": "*",
        "sourcePortRange": "*",
        "destinationAddressPrefix": "10.1.200.0/24",
        "destinationPortRanges": [
          "80",
          "443"
        ],
        "description": "Tool calls to vm-tools-ctrl (HS4)"
      }
    },
    {
      "condition": "[parameters('patchAgentSubnetNsg')]",
      "type": "Microsoft.Network/networkSecurityGroups/securityRules",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/{1}', parameters('nsgAgentSubnetName'), 'allow-out-mcr')]",
      "properties": {
        "priority": 125,
        "direction": "Outbound",
        "access": "Allow",
        "protocol": "Tcp",
        "sourceAddressPrefix": "*",
        "sourcePortRange": "*",
        "destinationAddressPrefix": "MicrosoftContainerRegistry",
        "destinationPortRange": "443",
        "description": "MCR base image pull -- required for ALL source-code deploy modes (C1 correction)"
      }
    },
    {
      "condition": "[parameters('patchAgentSubnetNsg')]",
      "type": "Microsoft.Network/networkSecurityGroups/securityRules",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/{1}', parameters('nsgAgentSubnetName'), 'allow-out-aad')]",
      "properties": {
        "priority": 126,
        "direction": "Outbound",
        "access": "Allow",
        "protocol": "Tcp",
        "sourceAddressPrefix": "*",
        "sourcePortRange": "*",
        "destinationAddressPrefix": "AzureActiveDirectory",
        "destinationPortRange": "443",
        "description": "*.login.microsoft.com for Micro VM auth -- required for ALL source-code deploy modes"
      }
    }
  ],
  "outputs": {
    "vnetToolsId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-tools')]"
    },
    "echoSubnetId": {
      "type": "string",
      "value": "[variables('echoSubnetId')]"
    },
    "ctrlSubnetId": {
      "type": "string",
      "value": "[variables('ctrlSubnetId')]"
    },
    "vmToolsEchoIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', 'nic-vm-tools-echo'), '2023-09-01').ipConfigurations[0].properties.privateIPAddress]"
    },
    "vmToolsCtrlIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', 'nic-vm-tools-ctrl'), '2023-09-01').ipConfigurations[0].properties.privateIPAddress]"
    },
    "dnsResolverInboundIp": {
      "type": "string",
      "value": "[if(parameters('deployDnsResolver'), reference(resourceId('Microsoft.Network/dnsResolvers/inboundEndpoints', 'dns-resolver-foundry', 'ep-inbound'), '2022-07-01').ipConfigurations[0].privateIpAddress, 'not-deployed')]"
    },
    "dnsResolverOutboundEpSubnetId": {
      "type": "string",
      "value": "[if(parameters('deployDnsResolver'), variables('dnsOutboundSubnetId'), 'not-deployed')]"
    }
  }
}