  "routeMaps": [
    {
      "id": "eu-export",
      "name": "EU nonlocal DC source prepend",
      "siteId": "router-eu",
      "rules": [
        {
          "id": "eu-prepend",
          "prefixes": [
            "10.120.0.0/24",
            "10.130.0.0/24",
            "10.140.0.0/24"
          ],
          "match": "equals",
          "action": "prepend",
          "summaryPrefixes": [],
          "prepend": [
            65011,
            65011,
            65011
          ],
          "nextStep": "terminate"
        }
      ]
    },
    {
      "id": "us-export",
      "name": "US nonlocal DC source prepend",
