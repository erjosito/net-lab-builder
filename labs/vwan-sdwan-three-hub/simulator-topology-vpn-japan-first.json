{
  "version": 1,
  "name": "Archived three-hub DC firewall control plane (not forwarding) - vpn-japan-first",
  "hubs": [
    {
      "id": "eu",
      "name": "hub-eu",
      "region": "westeurope",
      "preference": "VPN",
      "routingIntent": {
        "private": true,
        "internet": false,
        "privatePrefixes": []
      }
    },
    {
      "id": "us",
      "name": "hub-us",
      "region": "northcentralus",
      "preference": "VPN",
      "routingIntent": {
        "private": true,
        "internet": false,
        "privatePrefixes": []
      }
    },
    {
      "id": "jp",
      "name": "hub-jp",
      "region": "japaneast",
      "preference": "VPN",
      "routingIntent": {
        "private": true,
        "internet": false,
        "privatePrefixes": []
      }
    }
  ],
  "sites": [
    {
      "id": "router-eu",
      "name": "router-eu",
      "asn": 65011,
      "prefixes": [
        "10.110.0.0/24"
      ],
      "role": "spoke-nva",
      "routeMapAssignments": [
        {
          "connectionId": "cx-eu",
          "inboundMapId": "eu-import",
          "outboundMapId": "eu-export"
        }
      ]
    },
    {
      "id": "router-us",
      "name": "router-us",
      "asn": 65012,
      "prefixes": [
        "10.120.0.0/24"
      ],
      "role": "spoke-nva",
      "routeMapAssignments": [
        {
          "connectionId": "cx-us",
          "inboundMapId": "us-import",
          "outboundMapId": "us-export"
        }
      ]
    },
    {
      "id": "router-jp",
      "name": "router-jp",
      "asn": 65013,
      "prefixes": [
        "10.130.0.0/24"
      ],
      "routeMapAssignments": [
        {
          "connectionId": "cx-jp",
          "inboundMapId": "jp-import"
        }
      ]
    },
    {
      "id": "router-cn",
      "name": "router-cn",
      "asn": 65014,
      "prefixes": [
        "10.140.0.0/24"
      ]
    }
  ],
  "spokes": [
    {
      "id": "work-eu",
      "name": "spoke-eu",
      "hubId": "eu",
      "prefixes": [
        "10.10.0.0/24"
      ]
    },
    {
      "id": "work-us",
      "name": "spoke-us",
      "hubId": "us",
      "prefixes": [
        "10.20.0.0/24"
      ]
    },
    {
      "id": "work-jp",
      "name": "spoke-jp",
      "hubId": "jp",
      "prefixes": [
        "10.30.0.0/24"
      ]
    },
    {
      "id": "nva-eu",
      "name": "NVA host EU",
      "hubId": "eu",
      "prefixes": [
        "10.210.0.0/24"
      ]
    },
    {
      "id": "nva-us",
      "name": "NVA host US",
      "hubId": "us",
      "prefixes": [
        "10.220.0.0/24"
      ]
    }
  ],
  "connections": [
    {
      "id": "cx-eu",
      "name": "EU spoke NVA BGP",
      "hubId": "eu",
      "siteId": "router-eu",
      "transport": "SpokeNVA",
      "enabled": true,
      "inbound": [],
      "outbound": [],
      "spokeId": "nva-eu",
      "peerIp": "10.210.0.4",
      "learnSiteRoutes": true
    },
    {
      "id": "cx-us",
      "name": "US spoke NVA BGP",
      "hubId": "us",
      "siteId": "router-us",
      "transport": "SpokeNVA",
      "enabled": true,
      "inbound": [],
      "outbound": [],
      "spokeId": "nva-us",
      "peerIp": "10.220.0.4",
      "learnSiteRoutes": true
    },
    {
      "id": "cx-jp",
      "name": "Japan S2S VPN",
      "hubId": "jp",
      "siteId": "router-jp",
      "transport": "VPN",
      "enabled": true,
      "inbound": [],
      "outbound": [],
      "learnSiteRoutes": true
    }
  ],
  "siteLinks": [
